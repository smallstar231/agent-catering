# ============================================
# LangChain ReAct Agent - 环境变量模板
# 复制为 .env 并填入你的凭据：
#   cp .env.example .env
# ============================================

# 阿里云百炼 DashScope API Key（Python Agent 使用；同时用于 Rerank 精排 与 qwen-vl 读图）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Tavily 联网搜索 API Key（真实联网搜索工具使用；未配置则联网工具返回"未启用"提示）
# 申请地址：https://app.tavily.com/
# TAVILY_API_KEY=

# 网页正文读取可选白名单主机（逗号分隔）。不配置则放行全部公网地址（仍自动拦截内网/保留地址）
# PAGE_READ_ALLOW_HOSTS=

# ============================================
# AI 管理后台接口鉴权（Python Agent :8000 /ai/* 与 /sessions 管理接口）
# opt-in：不配置 = 不校验（本地开发零配置）；配置后强制要求请求头 X-AI-Admin-Token 匹配。
# 前端需在 .env.development.local 设同名 VUE_APP_AI_ADMIN_TOKEN，否则管理页返回 401。
AI_ADMIN_TOKEN=

# ============================================
# 苍穹外卖后端配置（仅在 Spring Boot 中使用）
# 实际值在 sky-server/src/main/resources/application-dev.yml 中
# ============================================
# MySQL 数据库
SKY_DATASOURCE_USERNAME=root
SKY_DATASOURCE_PASSWORD=your_mysql_password

# 阿里云 OSS
SKY_ALIOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
SKY_ALIOSS_ACCESS_KEY_ID=your_oss_key_id
SKY_ALIOSS_ACCESS_KEY_SECRET=your_oss_key_secret
SKY_ALIOSS_BUCKET_NAME=your_bucket_name

# 微信小程序
SKY_WECHAT_APPID=your_appid
SKY_WECHAT_SECRET=your_secret

# ============================================
# Python Agent → Spring Boot 管理员登录凭证
# 若未设置，默认使用 admin / 123456
# ============================================
SKY_ADMIN_USERNAME=admin
SKY_ADMIN_PASSWORD=your_admin_password
